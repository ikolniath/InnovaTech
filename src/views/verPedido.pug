extends layout

block content
  //-Cabecera del detalle con accesos rapidos para volver o editar
  .d-flex.flex-wrap.justify-content-between.align-items-center.mb-4.gap-2
    div
      h1.h3.mb-1= titulo
      p.text-muted.mb-0 Consulta la informacion completa del pedido seleccionado.
    .d-flex.gap-2
      a.btn.btn-outline-primary(href=`/pedidos/${pedido._id}/editar`) Editar pedido
      a.btn.btn-outline-secondary(href="/pedidos") Volver al listado

  //-Tarjeta con los datos principales del pedido
  .detail-card.p-4.p-lg-5
    .row.g-4
      .col-md-6
        h2.h6.text-uppercase.text-muted Producto
        p.fs-5.mb-0.fw-semibold= pedido.producto
      .col-md-6
        h2.h6.text-uppercase.text-muted Cliente
        p.fs-5.mb-0.fw-semibold= pedido.cliente
      .col-md-4
        h2.h6.text-uppercase.text-muted Cantidad
        p.fs-5.mb-0= pedido.cantidad
      .col-md-4
        h2.h6.text-uppercase.text-muted Estado actual
        if pedido.estado === 'pendiente'
          span.badge.text-bg-warning.fs-6.status-label= pedido.estado
        else if pedido.estado === 'en producci\u00f3n'
          span.badge.text-bg-primary.fs-6.status-label= pedido.estado
        else if pedido.estado === 'despachado'
          span.badge.text-bg-info.fs-6.status-label= pedido.estado
        else
          span.badge.text-bg-success.fs-6.status-label= pedido.estado
      .col-md-4
        h2.h6.text-uppercase.text-muted Fecha de registro
        p.fs-5.mb-0= new Date(pedido.fechaCreacion).toLocaleString('es-AR')
    hr
    form(method="post", action=`/pedidos/${pedido._id}/eliminar`, onsubmit="return confirm('Esta accion eliminara el pedido. Deseas continuar?');")
      button.btn.btn-outline-danger(type="submit") Eliminar pedido
