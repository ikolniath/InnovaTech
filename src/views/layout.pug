doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= pageTitle || 'InnovaTech'
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH", crossorigin="anonymous")
    style.
      :root {
        --app-bg: #f3f6fb;
        --app-surface: #ffffff;
        --app-surface-soft: #f8fafc;
        --app-border: #d9e2ec;
        --app-text: #1f2937;
        --app-muted: #667085;
        --app-primary: #1f4b6e;
        --app-primary-dark: #173854;
        --app-accent: #c99131;
        --app-danger: #b54747;
        --app-success: #1f7a5c;
        --app-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
      }

      body {
        background:
          radial-gradient(circle at top left, rgba(31, 75, 110, 0.08), transparent 32%),
          linear-gradient(180deg, #f8fbff 0%, var(--app-bg) 100%);
        color: var(--app-text);
      }

      .app-navbar {
        background: linear-gradient(135deg, #15324b 0%, #1f4b6e 100%);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
      }

      .navbar-brand {
        letter-spacing: 0.04em;
      }

      .nav-link {
        color: rgba(255, 255, 255, 0.8);
      }

      .nav-link:hover,
      .nav-link:focus,
      .nav-link.active {
        color: #ffffff;
      }

      .page-shell {
        padding-top: 2rem;
        padding-bottom: 2.5rem;
      }

      .hero-panel,
      .card-surface,
      .table-shell {
        background: var(--app-surface);
        border: 1px solid rgba(217, 226, 236, 0.9);
        border-radius: 1.25rem;
        box-shadow: var(--app-shadow);
      }

      .hero-panel {
        position: relative;
        overflow: hidden;
      }

      .hero-panel::after {
        content: '';
        position: absolute;
        inset: auto -10% -18% auto;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(201, 145, 49, 0.18), transparent 65%);
        pointer-events: none;
      }

      .feature-card,
      .form-card,
      .detail-card {
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(217, 226, 236, 0.9);
        border-radius: 1rem;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
      }

      .table > :not(caption) > * > * {
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
      }

      .table-dark {
        --bs-table-bg: #15324b;
        --bs-table-border-color: #224866;
      }

      .table-shell .table {
        margin-bottom: 0;
      }

      .btn-primary {
        --bs-btn-bg: var(--app-primary);
        --bs-btn-border-color: var(--app-primary);
        --bs-btn-hover-bg: var(--app-primary-dark);
        --bs-btn-hover-border-color: var(--app-primary-dark);
        --bs-btn-active-bg: var(--app-primary-dark);
        --bs-btn-active-border-color: var(--app-primary-dark);
      }

      .btn-outline-primary {
        --bs-btn-color: var(--app-primary);
        --bs-btn-border-color: rgba(31, 75, 110, 0.45);
        --bs-btn-hover-bg: var(--app-primary);
        --bs-btn-hover-border-color: var(--app-primary);
        --bs-btn-active-bg: var(--app-primary-dark);
        --bs-btn-active-border-color: var(--app-primary-dark);
      }

      .btn-outline-secondary {
        --bs-btn-color: #485467;
        --bs-btn-border-color: rgba(72, 84, 103, 0.35);
        --bs-btn-hover-bg: #485467;
        --bs-btn-hover-border-color: #485467;
      }

      .btn-outline-danger {
        --bs-btn-color: var(--app-danger);
        --bs-btn-border-color: rgba(181, 71, 71, 0.35);
        --bs-btn-hover-bg: var(--app-danger);
        --bs-btn-hover-border-color: var(--app-danger);
      }

      .btn-warning {
        --bs-btn-bg: var(--app-accent);
        --bs-btn-border-color: var(--app-accent);
        --bs-btn-hover-bg: #b88226;
        --bs-btn-hover-border-color: #b88226;
        --bs-btn-color: #17212b;
      }

      .form-control,
      .form-select {
        border-color: var(--app-border);
        padding-top: 0.78rem;
        padding-bottom: 0.78rem;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: rgba(31, 75, 110, 0.45);
        box-shadow: 0 0 0 0.2rem rgba(31, 75, 110, 0.12);
      }

      .alert {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
      }

      .alert-warning {
        background: #fff4da;
        color: #6e4d08;
      }

      .alert-success {
        background: #eaf7f1;
        color: #195741;
      }

      .alert-danger {
        background: #fdecec;
        color: #7f1d1d;
      }

      .alert-secondary,
      .alert-info {
        background: #edf4fb;
        color: #234563;
      }

      .badge {
        padding: 0.6em 0.85em;
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .text-bg-warning {
        background-color: #f4d58d !important;
        color: #533b00 !important;
      }

      .text-bg-primary {
        background-color: #cfe0ef !important;
        color: #15324b !important;
      }

      .text-bg-info {
        background-color: #d6eef5 !important;
        color: #0f4f63 !important;
      }

      .text-bg-success {
        background-color: #d7efe4 !important;
        color: #14523d !important;
      }

      .status-label {
        display: inline-block;
        min-width: 7.5rem;
        text-align: center;
      }

      .app-footer {
        background: #12293d;
      }

      details summary {
        cursor: pointer;
        font-weight: 600;
        color: var(--app-primary);
      }

      pre {
        white-space: pre-wrap;
        word-break: break-word;
      }

      @media (max-width: 767.98px) {
        .page-shell {
          padding-top: 1.5rem;
          padding-bottom: 2rem;
        }
      }
  body(class="d-flex flex-column min-vh-100")
    //-Navbar principal con accesos rapidos segun el estado de la sesion
    nav.navbar.navbar-expand-lg.navbar-dark.app-navbar
      .container
        a.navbar-brand.fw-bold(href="/") InnovaTech
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#mainNavbar", aria-controls="mainNavbar", aria-expanded="false", aria-label="Toggle navigation")
          span.navbar-toggler-icon
        #mainNavbar.collapse.navbar-collapse
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link(class=currentPath === '/' ? 'active' : '', href="/") Inicio
            if usuario
              li.nav-item
                a.nav-link(class=currentPath === '/pedidos' ? 'active' : '', href="/pedidos") Pedidos
              li.nav-item
                a.nav-link(href="/pedidos/nuevo") Registrar pedido
          ul.navbar-nav.ms-auto.align-items-lg-center
            if usuario
              li.nav-item.me-lg-3.text-white.small
                | #{usuario.nombre} (#{usuario.rol})
              li.nav-item
                form(method="post", action="/auth/logout")
                  button.btn.btn-outline-light.btn-sm(type="submit") Cerrar sesion
            else
              li.nav-item
                a.btn.btn-warning.btn-sm(href="/auth/login") Iniciar sesion
    //-Contenedor principal donde se muestra cada vista y los mensajes flash
    main.container.page-shell.flex-grow-1
      if flash
        .alert(class=`alert-${flash.type || 'info'}`)= flash.message
      block content
    //-Pie simple para mantener una identidad mas profesional y consistente
    footer.app-footer.text-white-50.py-3.mt-auto
      .container.text-center.small
        | InnovaTech | Plataforma interna para la gestion de pedidos.
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js", integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz", crossorigin="anonymous")
