extends layout

block content
  section.encabezado
    h1= titulo
    p= subtitulo

  if pedidos.length
    section.lista-pedidos
      each pedido in pedidos
        article.pedido
          h2 Pedido ##{pedido.id}
          p
            strong Producto:
            |  #{pedido.producto}
          p
            strong Cantidad:
            |  #{pedido.cantidad}
          p
            strong Cliente:
            |  #{pedido.cliente}
          if pedido.estado === 'entregado'
            p.estado.entregado Estado: #{pedido.estado}
          else if pedido.estado === 'despachado'
            p.estado.despachado Estado: #{pedido.estado}
          else if pedido.estado === 'en producci\u00f3n'
            p.estado.produccion Estado: #{pedido.estado}
          else
            p.estado.pendiente Estado: #{pedido.estado}
  else
    p No hay pedidos registrados en este momento.
